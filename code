"""
Student Management System (Simple Version)
============================================
A beginner-friendly mini project.

This program lets you:
1. Add a student
2. View all students
3. Search for a student
4. Update a student's details
5. Delete a student
6. Exit

No classes, no database - just simple functions and a list of
dictionaries stored in memory (data resets each time you run it).
"""

# This list will store all student records.
# Each student is a dictionary like:
# {"id": 1, "name": "Ravi", "age": 20, "course": "CSE", "marks": 85}
students = []

# This keeps track of the next ID to give a new student
next_id = 1


def add_student():
    global next_id
    print("\n--- Add New Student ---")
    name = input("Enter name: ")
    age = input("Enter age: ")
    course = input("Enter course: ")
    marks = input("Enter marks: ")

    student = {
        "id": next_id,
        "name": name,
        "age": age,
        "course": course,
        "marks": marks
    }

    students.append(student)
    print(f"Student '{name}' added successfully with ID {next_id}!")
    next_id += 1  # increase ID for the next student


def view_students():
    print("\n--- All Students ---")
    if len(students) == 0:
        print("No students found.")
        return

    print(f"{'ID':<5}{'Name':<15}{'Age':<6}{'Course':<10}{'Marks':<6}")
    print("-" * 42)
    for s in students:
        print(f"{s['id']:<5}{s['name']:<15}{s['age']:<6}{s['course']:<10}{s['marks']:<6}")


def search_student():
    print("\n--- Search Student ---")
    search_id = input("Enter Student ID to search: ")

    for s in students:
        if str(s["id"]) == search_id:
            print(f"ID: {s['id']}")
            print(f"Name: {s['name']}")
            print(f"Age: {s['age']}")
            print(f"Course: {s['course']}")
            print(f"Marks: {s['marks']}")
            return

    print("Student not found.")


def update_student():
    print("\n--- Update Student ---")
    update_id = input("Enter Student ID to update: ")

    for s in students:
        if str(s["id"]) == update_id:
            print("Leave a field blank to keep it unchanged.")
            name = input(f"New name (current: {s['name']}): ")
            age = input(f"New age (current: {s['age']}): ")
            course = input(f"New course (current: {s['course']}): ")
            marks = input(f"New marks (current: {s['marks']}): ")

            if name != "":
                s["name"] = name
            if age != "":
                s["age"] = age
            if course != "":
                s["course"] = course
            if marks != "":
                s["marks"] = marks

            print("Student updated successfully!")
            return

    print("Student not found.")


def delete_student():
    print("\n--- Delete Student ---")
    delete_id = input("Enter Student ID to delete: ")

    for s in students:
        if str(s["id"]) == delete_id:
            students.remove(s)
            print("Student deleted successfully!")
            return

    print("Student not found.")


def main():
    while True:
        print("\n========================================")
        print("      STUDENT MANAGEMENT SYSTEM")
        print("========================================")
        print("1. Add Student")
        print("2. View All Students")
        print("3. Search Student")
        print("4. Update Student")
        print("5. Delete Student")
        print("6. Exit")

        choice = input("Enter your choice (1-6): ")

        if choice == "1":
            add_student()
        elif choice == "2":
            view_students()
        elif choice == "3":
            search_student()
        elif choice == "4":
            update_student()
        elif choice == "5":
            delete_student()
        elif choice == "6":
            print("Thank you for using the Student Management System. Goodbye!")
            break
        else:
            print("Invalid choice. Please enter a number between 1 and 6.")


# This runs the program when the file is executed
if __name__ == "__main__":
    main()
